# Which AI answers the chat:
#   gemini             Google, cloud
#   ollama             local model on this machine (free, private)
#   openai_compatible  any inference server: vLLM, SGLang, LM Studio, Groq, Together, OpenRouter ...
AI_PROVIDER=ollama


# Fallback chain (optional): providers tried in order until one answers.
# Overrides AI_PROVIDER when set. Names: groq, openrouter, gemini, ollama, openai_compatible
AI_CHAIN=

# Groq: fast hosted Qwen with a free tier (console.groq.com). GROQ_KEY also works as the name.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter: many models, free ":free" variants (openrouter.ai)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.6-27b:free

# Inference server settings (only used when AI_PROVIDER=openai_compatible). Examples:
#   your own vLLM:  AI_BASE_URL=http://localhost:8001/v1   AI_MODEL=Qwen/Qwen3.5-4B
#   Groq (hosted):  AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=<model id>   AI_API_KEY=<key>
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Local model settings (only used when AI_PROVIDER=ollama). Download with: ollama pull qwen3.5:2b
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_URL=http://localhost:11434

# Google Gemini API Key (needed when AI_PROVIDER=gemini)
GOOGLE_API_KEY=your-google-api-key-here

# Gemini model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Custom code steps run Python with full access to this machine (like Jupyter).
# Fine on your own laptop; set to false on any shared or public server.
ALLOW_CUSTOM_CODE=true

# API Authentication Key (optional, leave empty to disable auth)
API_SECRET_KEY=

# CORS Origins (comma-separated, default: *)
CORS_ORIGINS=*

# Max upload size in MB (default: 50)
MAX_UPLOAD_SIZE_MB=50

# Session TTL in hours (default: 24)
SESSION_TTL_HOURS=24

# Database. Leave empty for a local SQLite file (private, works offline).
# For a deployment, use a PostgreSQL URL, e.g. from Supabase:
#   DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres
# (also: pip install "psycopg[binary]")
DATABASE_URL=
