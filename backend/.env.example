# Copy this file to .env and fill in what you use. Never commit .env (it holds your keys).

# ── AI ────────────────────────────────────────────────────────────────────────────
# Fallback chain: providers tried in order until one answers. Each reply says who answered.
# Names: groq, openrouter, gemini, ollama, openai_compatible. Leave empty to use AI_PROVIDER alone.
AI_CHAIN=groq,gemini,openrouter,ollama

# Single provider (used only when AI_CHAIN is empty):
#   gemini             Google, cloud
#   ollama             local model on this machine (free, private)
#   openai_compatible  any inference server: vLLM, SGLang, LM Studio, Groq, Together, OpenRouter ...
AI_PROVIDER=ollama

# Groq: fast hosted Qwen with a free tier (console.groq.com). GROQ_KEY also works as the name.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter: many models, free ":free" variants (openrouter.ai). Free models come and go.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Google Gemini (aistudio.google.com)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local model via Ollama. Download with: ollama pull qwen3.5:2b
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_URL=http://localhost:11434

# Any OpenAI-compatible server (AI_PROVIDER=openai_compatible or "openai_compatible" in AI_CHAIN). Examples:
#   your own vLLM:  AI_BASE_URL=http://localhost:8001/v1   AI_MODEL=Qwen/Qwen3.5-4B
#   hosted API:     AI_BASE_URL=https://<provider>/v1       AI_MODEL=<model id>   AI_API_KEY=<key>
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# ── Safety (change these for a public deployment) ─────────────────────────────────
# Code cells. Code never runs inside the app, but WHERE it runs matters:
#   local     (your laptop) a separate worker with a time limit: no other protection
#   hardened  (a server, in the Docker image) its own user id, limits, no network, no programs;
#             self-tested at startup, falls back to Modal (below) or stays off if the test fails
#   modal     a hosted Modal sandbox
ALLOW_CUSTOM_CODE=true
CODE_SANDBOX=local
# everyone, or accounts (only signed-in users may run code: right for a public site)
CODE_FOR=accounts
CODE_TIME_LIMIT_SECONDS=60
CODE_MEMORY_MB=2048
# Modal (https://modal.com, free plan has monthly credit): only for CODE_SANDBOX=modal or as fallback
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Sites allowed to call the API (comma-separated). Set to your real site when deployed.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Usage limits (protect free AI allowances and the server)
RATE_LIMITS=true
AI_PER_MINUTE=10
AI_DAILY_LIMIT=500
UPLOADS_PER_HOUR=20
TRAININGS_PER_HOUR=60
MAX_UPLOAD_SIZE_MB=20
MAX_ROWS=200000
MAX_COLUMNS=200

# Delete ANONYMOUS notebooks unused for this many hours (signed-in users' notebooks are kept).
# 0 = keep forever (right for your laptop); a public demo should use something like 72.
SESSION_TTL_HOURS=72

# Notebooks kept loaded in memory; the rest reload from storage when opened.
# Lower it on a small server (each can hold a dataset of up to MAX_ROWS rows).
MAX_SESSIONS_IN_MEMORY=30

# ── Accounts (optional) ───────────────────────────────────────────────────────────
# Your Supabase project URL lets people sign in and keep notebooks on any device.
# No secret key needed: login tokens are checked with Supabase's published public key.
# Empty = anonymous visitors only (each browser keeps its own notebooks).
SUPABASE_URL=

# Store the data files (uploads, locked train/test rows) in a private Supabase Storage bucket
# instead of backend/data. This key can read and write EVERYTHING in your project:
# backend only, never in the frontend, never committed. (Supabase: Project Settings > API Keys > Secret keys)
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=notebooks

# ── Storage ───────────────────────────────────────────────────────────────────────
# Leave empty for a local SQLite file (private, works offline).
# For a deployment, a PostgreSQL URL works too, e.g. Supabase > Connect > Session pooler:
#   DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Contains your database password: a secret. Move existing local notebooks with: python -m app.migrate
DATABASE_URL=
