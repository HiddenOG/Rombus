# Copy to .env and fill in. Everything here ends up in the browser, so only public values belong here.

# Where the backend runs
VITE_API_URL=http://localhost:8000

# Sign-in (optional): Supabase project URL and its publishable ("anon public") key.
# Leave empty to run with anonymous visitors only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
